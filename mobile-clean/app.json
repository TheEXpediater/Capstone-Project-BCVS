{
  "expo": {
    "name": "CredPocket Clean",
    "slug": "credpocket-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "credpocket",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CredPocket uses the camera to scan credential and verification QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.psau.credpocket.clean"
    },
    "android": {
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "package": "com.psau.credpocket.clean"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "API_URL": "http://localhost:5000",
      "WEB_BASE": "http://localhost:5173/verification-portal",
      "eas": {
        "projectId": ""
      }
    }
  }
}
