{
  "name": "bcvs-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-system.js",
    "setup:system": "node scripts/setup-system.js",

    "seed": "npm run seed --prefix server",
    "flush:data": "npm run flush:data --prefix server",
    "verify:seed": "npm run verify:seed --prefix server",

    "start": "npm run start:bcvs",

    "start:server": "node scripts/start-service.js backend",
    "start:client": "node scripts/start-service.js frontend",

    "start:tunnel": "C:\\cloudflared.exe tunnel run bcvs",

    "start:bcvs": "npm run start:full",

    "start:full": "node -e \"console.log('Starting BCVS...')\" && concurrently --names Backend,Frontend,Tunnel --prefix-colors blue,green,yellow --kill-others-on-fail \"npm run start:server\" \"npm run start:client\" \"npm run start:tunnel\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}