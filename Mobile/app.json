{
  "expo": {
    "name": "CredPocket Clean",
    "slug": "credpocket-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "credpocket",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CredPocket uses the camera to scan credential and verification QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.psau.credpocket.clean"
    },
    "android": {
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.psau.credpocket.clean"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashscreen_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "react-native-vision-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 26,
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "DOMAIN_API_BASE_URL": "https://api.psau-credentials.cfd/api",
      "DOMAIN_WEB_BASE_URL": "https://psau-credentials.cfd",
      "VERIFICATION_WEB_BASE_URL": "https://psau-credentials.cfd",
      "SHOW_CONNECTION_TOOLS": "false",
      "SHOW_DISCOVERY_TOOLS": "false",
      "eas": {
        "projectId": "e4c6cd8c-4086-47e3-83b2-eb97cf304c3d"
      },
      "router": {}
    }
  }
}
